#!/bin/bash
# Pi Hub release: test a pushed version, switch to it, check it, and switch back if it fails.
# Runs as root from the git hook in /srv/pi-hub.git (after "git push pi main" on the Mac),
# or by hand: sudo /usr/local/lib/pi-hub/pi-hub-release <commit>
set -euo pipefail
SHA="$1"
REPO=/srv/pi-hub.git
BASE=/opt/pi-hub
REL=$BASE/releases
CUR=$BASE/current
LOG=/var/lib/pi-hub-releases/releases.json
# release:pi-hub (platform step 3): the hub reads each report from here; the newest 10 are kept.
INBOX=/var/lib/pi-hub-releases/inbox
# Serialise pushes and owner-requested rollbacks.
exec 9>/var/lock/pi-hub-release.lock
flock -n 9 || { echo "pi-hub: another release is running"; exit 1; }
SHA=$(git --git-dir="$REPO" rev-parse --verify "$SHA^{commit}")
SHORT="${SHA:0:10}"
NEW="$REL/$SHORT"
say() { echo "pi-hub: $*"; }

record() {  # status message [restored]
  python3 - "$LOG" "$SHORT" "$1" "$2" "$(git --git-dir="$REPO" log -1 --format=%s "$SHA" 2>/dev/null)" "${3:-}" <<'PY'
import json, os, sys, time
path, sha, status, message, subject, restored = sys.argv[1:]
os.makedirs(os.path.dirname(path), exist_ok=True)
try:
    data = json.load(open(path))
except (OSError, ValueError):
    data = []
entry = {"sha": sha, "status": status, "message": message, "subject": subject[:120], "ts": int(time.time())}
if restored:
    entry["restored"] = restored
data.insert(0, entry)
json.dump(data[:30], open(path + ".tmp", "w"))
os.chmod(path + ".tmp", 0o644)
os.replace(path + ".tmp", path)
PY
}

report() {  # result running message: this release's report for release:pi-hub; it never fails the release
  python3 - "$INBOX" "$SHA" "$1" "$2" "$3" "$(git --git-dir="$REPO" rev-parse --verify -q refs/heads/main 2>/dev/null || true)" <<'PY' || say "couldn't write the release report"
import glob, json, os, re, sys, time
from datetime import datetime, timezone
inbox, commit, result, running, message, head = sys.argv[1:]
hexsha = re.compile(r"[0-9a-f]{7,40}")
if result == "rolled-back" and not hexsha.fullmatch(running):
    result, running = "failed", ""  # the restored release has no commit name; the hub keeps what it knew
body = {"target": "pi-hub", "commit": commit, "result": result, "at": datetime.now(timezone.utc).isoformat(),
        "mechanism": "pi-hub-release", "message": message[:200]}
if running:
    body["running"] = running
if hexsha.fullmatch(head):
    body["head"] = head
os.makedirs(inbox, exist_ok=True)
name = os.path.join(inbox, f"pi-hub-{time.time_ns()}-{os.getpid()}.json")
with open(name + ".tmp", "w") as f:
    json.dump(body, f)
os.chmod(name + ".tmp", 0o644)
os.replace(name + ".tmp", name)
for old in sorted(glob.glob(os.path.join(inbox, "pi-hub-*.json")), key=os.path.getmtime)[:-10]:
    os.remove(old)
PY
}

if [ "$(readlink -f "$CUR" 2>/dev/null || true)" = "$NEW" ]; then
  say "$SHORT is already running"
  exit 0
fi

wait_healthy() {
  for i in $(seq 1 30); do
    if curl --max-time 2 -fs -o /dev/null "$1"; then return 0; fi
    sleep 1
  done
  return 1
}
# A release with the front gate runs its hub on 127.0.0.1:8100 behind Caddy on :80; one from before the gate runs
# its hub on :80 itself. Either way the old address must answer.
gated() { [ -f "$1/deploy/caddy/Caddyfile" ]; }
healthy_for() {
  if gated "$1"; then wait_healthy http://127.0.0.1:8100/healthz && wait_healthy http://127.0.0.1/healthz
  else wait_healthy http://127.0.0.1/healthz; fi
}

mkdir -p "$REL"
rm -rf "$NEW.tmp" && mkdir -p "$NEW.tmp"
git --git-dir="$REPO" archive "$SHA" | tar -x -C "$NEW.tmp" || { say "couldn't unpack $SHORT"; record failed "Couldn't unpack it."; report failed "" "Couldn't unpack it."; exit 1; }

say "testing ${SHORT}…"
# Everything the tests write goes under one folder on the SD card, removed after: /tmp is a small RAM disk, and the
# tests' own temp folders, left there by each release, filled it until the lab's "1 GiB free" check refused uploads.
mkdir -p /var/tmp
TESTDB=$(mktemp -d -p /var/tmp pi-hub-test.XXXXXX)
mkdir -p "$TESTDB/tmp"
export TMPDIR="$TESTDB/tmp"
if ! (cd "$NEW.tmp" && HUB_NO_SAMPLER=1 HUB_DB="$TESTDB/t.db" timeout 600 python3 -m pytest -q -p no:cacheprovider tests > "$TESTDB/test.log" 2>&1); then
  tail -15 "$TESTDB/test.log"
  say "tests failed; the running version is unchanged"
  record failed "Tests failed; nothing changed."
  report failed "" "Tests failed; nothing changed."
  rm -rf "$NEW.tmp" "$TESTDB"
  exit 1
fi
say "$(tail -1 "$TESTDB/test.log")"
if compgen -G "$NEW.tmp/tests/*.mjs" >/dev/null && ! (cd "$NEW.tmp" && timeout 120 node --test tests/*.mjs > "$TESTDB/js.log" 2>&1); then
  tail -15 "$TESTDB/js.log"
  record failed "JavaScript tests failed; nothing changed."
  report failed "" "JavaScript tests failed; nothing changed."
  rm -rf "$NEW.tmp" "$TESTDB"
  exit 1
fi
say "JavaScript tests passed"
rm -rf "$TESTDB"
unset TMPDIR
rm -rf "$NEW" && mv "$NEW.tmp" "$NEW"
find "$NEW" -name __pycache__ -prune -exec rm -rf {} +
for s in 180 192 512; do rsvg-convert -w $s -h $s "$NEW/hub/static/icon.svg" -o "$NEW/hub/static/icon-$s.png"; done

if gated "$NEW" && { [ ! -d /etc/caddy ] || ! command -v caddy >/dev/null; }; then
  say "this version needs the front gate (Caddy), which isn't installed; run deploy/install.sh from the Mac"
  exit 1
fi

# Snapshot every installed supporting file before touching the running release.
PREV=$(readlink -f "$CUR" 2>/dev/null || true)
SNAP=$(mktemp -d)
SUPPORT=(/usr/local/bin/pi-status.py)
for f in pi-hub-helper.py pi-hub-backup.sh x2d-camera-failover.py pi-hub-selfcheck.py pi-hub-movies-mirror.py pi-hub-release pi-backup-serve pi-paperless-backup.sh pi-hub-heartbeat.sh; do
  SUPPORT+=("/usr/local/lib/pi-hub/$f")
done
for u in pi-hub.service pi-hub-helper.service pi-hub-backup.service pi-hub-backup.timer x2d-camera-failover.service pi-hub-selfcheck.service pi-hub-selfcheck.timer \
         pi-hub-movies-mount.service pi-hub-movies-mount.timer \
         pi-hub-movies-mirror.service pi-hub-movies-mirror.timer pi-paperless-backup.service pi-paperless-backup.timer \
         pi-hub-heartbeat.service pi-hub-heartbeat.timer; do
  SUPPORT+=("/etc/systemd/system/$u")
done
SUPPORT+=(/etc/systemd/system/x2d-camera-bridge.service.d/port.conf)
SUPPORT+=(/etc/caddy/Caddyfile)
for f in "${SUPPORT[@]}"; do
  if [ -e "$f" ] || [ -L "$f" ]; then
    mkdir -p "$SNAP$(dirname "$f")"
    cp -a "$f" "$SNAP$f"
  fi
done
recover() {
  result=$?
  trap - EXIT
  if [ "$result" != 0 ]; then
    say "release failed; restoring application and supporting files"
    restored=1
    rm -f /usr/local/lib/pi-hub/pi-hub-release.new || restored=0
    for f in "${SUPPORT[@]}"; do
      if [ -e "$SNAP$f" ] || [ -L "$SNAP$f" ]; then
        rm -f "$f" && cp -a "$SNAP$f" "$f" || restored=0
      else
        rm -f "$f" || restored=0
      fi
    done
    if [ -n "$PREV" ] && [ -d "$PREV" ]; then
      ln -sfn "$PREV" "$CUR.new" && mv -T "$CUR.new" "$CUR" || restored=0
    else
      rm -f "$CUR" || restored=0
      restored=0
    fi
    systemctl daemon-reload || restored=0
    # The gate holds :80 in front of the hub; a hub from before the gate needs :80 back.
    if [ -d /etc/caddy ] && [ ! -f "$PREV/deploy/caddy/Caddyfile" ]; then systemctl stop caddy || restored=0; fi
    systemctl restart pi-status pi-hub pi-hub-helper x2d-camera-failover || restored=0
    if [ -d /etc/caddy ] && [ -f "$PREV/deploy/caddy/Caddyfile" ]; then systemctl restart caddy || restored=0; fi
    if systemctl cat x2d-camera-bridge.service >/dev/null 2>&1; then
      systemctl restart x2d-camera-bridge || restored=0
    fi
    if [ "$restored" = 1 ] && healthy_for "$PREV"; then
      record rolled-back "Release failed; restored the previous app and supporting files." "$(basename "$PREV")" || true
      report rolled-back "$(basename "$PREV")" "Release failed; restored the previous app and supporting files." || true
    else
      record failed "Release failed; recovery needs attention. Snapshot: $SNAP" || true
      report failed "" "Release failed; recovery needs attention." || true
      say "recovery needs attention; snapshot retained at $SNAP"
      exit "$result"
    fi
  fi
  rm -rf "$SNAP"
  exit "$result"
}
trap recover EXIT

# The parts that run outside the hub: helper, backup, camera address, self-check, status service and units.
D="$NEW/deploy"
install -d -m 755 /usr/local/lib/pi-hub
install -m 755 "$D/pi-hub-helper.py" "$D/pi-hub-backup.sh" "$D/x2d-camera-failover.py" "$D/pi-hub-selfcheck.py" "$D/pi-hub-movies-mirror.py" \
  "$D/pi-backup-serve" "$D/pi-paperless-backup.sh" "$D/pi-hub-heartbeat.sh" /usr/local/lib/pi-hub/
# Replace the runner atomically: a manual rollback may be executing this file.
install -m 755 "$D/pi-hub-release" /usr/local/lib/pi-hub/pi-hub-release.new
mv -f /usr/local/lib/pi-hub/pi-hub-release.new /usr/local/lib/pi-hub/pi-hub-release
for u in pi-hub.service pi-hub-helper.service pi-hub-backup.service pi-hub-backup.timer x2d-camera-failover.service \
         pi-hub-selfcheck.service pi-hub-selfcheck.timer pi-hub-movies-mount.service pi-hub-movies-mount.timer \
         pi-hub-movies-mirror.service pi-hub-movies-mirror.timer pi-paperless-backup.service pi-paperless-backup.timer \
         pi-hub-heartbeat.service pi-hub-heartbeat.timer; do
  install -m 644 "$D/$u" "/etc/systemd/system/$u"
done
if [ -f /etc/systemd/system/x2d-camera-bridge.service ]; then
  install -d -m 755 /etc/systemd/system/x2d-camera-bridge.service.d
  install -m 644 "$D/x2d-camera-bridge.service.d/port.conf" /etc/systemd/system/x2d-camera-bridge.service.d/port.conf
fi
if ! cmp -s "$D/pi-status.py" /usr/local/bin/pi-status.py; then
  install -m 755 "$D/pi-status.py" /usr/local/bin/pi-status.py && systemctl restart pi-status
fi
# The front gate (Caddy) answers :80/:443 and passes to the hub on 127.0.0.1:8100. A release from before the gate
# (a manual rollback) runs its hub on :80, so Caddy stops for it.
if [ -d /etc/caddy ]; then
  if [ -f "$D/caddy/Caddyfile" ]; then
    install -m 644 "$D/caddy/Caddyfile" /etc/caddy/Caddyfile
    caddy validate --adapter caddyfile --config /etc/caddy/Caddyfile >/dev/null
  else
    systemctl stop caddy
  fi
fi
systemctl daemon-reload

ln -sfn "$NEW" "$CUR.new" && mv -T "$CUR.new" "$CUR"
systemctl restart pi-hub pi-hub-helper x2d-camera-failover
if [ -d /etc/caddy ] && [ -f "$D/caddy/Caddyfile" ]; then
  systemctl restart caddy
fi
if systemctl cat x2d-camera-bridge.service >/dev/null 2>&1; then
  systemctl restart x2d-camera-bridge
fi

say "checking the new version…"
ok=0
healthy_for "$NEW" && ok=1 || ok=0
if [ $ok = 1 ]; then
  sleep 3
  python3 "$NEW/deploy/pi-hub-selfcheck.py" --gate > /tmp/pi-hub-gate.json 2>/dev/null && ok=1 || ok=0
fi
if [ $ok = 1 ]; then
  say "$SHORT is live"
  record live "Tests passed and every page and API answered."
  report deployed "" "Tests passed and every page and API answered."
else
  say "$SHORT failed its checks; switching back"
  cat /tmp/pi-hub-gate.json 2>/dev/null | python3 -c "import json,sys; [print('  failed:', c['name'], c['detail']) for c in json.load(sys.stdin)['checks'] if not c['ok']]" 2>/dev/null || true
  exit 1
fi

trap - EXIT
rm -rf "$SNAP"

# The git hook runs pi-hub-release-incoming, which only install.sh used to refresh, so a change to this runner
# reached pushes only after an install. Once a release is live it becomes this release's runner (atomically: it may be
# the file running now).
{ install -m 755 "$D/pi-hub-release" /usr/local/lib/pi-hub/pi-hub-release-incoming.new &&
  mv -f /usr/local/lib/pi-hub/pi-hub-release-incoming.new /usr/local/lib/pi-hub/pi-hub-release-incoming; } ||
  say "couldn't refresh the push runner; run deploy/install.sh from the Mac"

# The display's OTA publish hook (deploy/bambuhelper-post-receive, release:firmware) lives in this repo too. Once a
# release is live it becomes the hook of the firmware repo, so the next "git push pi main" there runs it.
OTA_HOOKS=/srv/bambuhelper-smart-display.git/hooks
if [ -d "$OTA_HOOKS" ]; then
  { install -m 755 "$D/bambuhelper-post-receive" "$OTA_HOOKS/post-receive.new" &&
    mv -f "$OTA_HOOKS/post-receive.new" "$OTA_HOOKS/post-receive"; } || say "couldn't refresh the OTA publish hook"
fi

# The outside heartbeat (platform baseline D2) starts only once a release is live. It skips itself until
# /etc/pi-hub/healthchecks.env exists.
systemctl enable --now pi-hub-heartbeat.timer >/dev/null 2>&1 || say "could not start the heartbeat timer"

# Keep the five newest releases, plus whatever is running.
ls -1dt "$REL"/*/ 2>/dev/null | tail -n +6 | while read -r d; do
  [ "$(readlink -f "$CUR")/" = "$d" ] || rm -rf "$d"
done
exit 0
