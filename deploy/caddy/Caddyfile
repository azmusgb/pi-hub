# The front gate (docs/superpowers/specs/2026-10-24-one-home-design.md, 2026-11-01-real-names-design.md). Every house
# tool at https://<tool>.rahe-home.duckdns.org, the hub at hub., behind one sign-in: Pi Hub's owner session, checked at
# GET /api/gate. Their certificate is a real Let's Encrypt one. Caddy's own CA remains only for the Workshop display,
# which still pins home.home.arpa and updates.home.arpa to this CA; never delete /var/lib/caddy while it does.
{
	local_certs
	# The admin API would show the whole config, including Grafana's secret header name, to anything on the Pi;
	# a socket in /run/caddy (0700, caddy only) keeps it to Caddy and root.
	admin unix//run/caddy/admin.sock
}

# The client's address and Caddy's secret for the hub (hub/devices.py), replacing anything the client sent: the owner's
# own Tailscale devices are the owner. The secret is in /etc/pi-hub/secrets/hub_proxy.env; Caddy won't start without it.
(hub_peer) {
	header_up X-Hub-Peer {remote_host}
	header_up X-Hub-Proxy {$HUB_PROXY_SECRET}
}

# Strip identity headers a client might send, ask the hub, then pass only the hub's answer on (never its cookie). Inside `route` so
# these run in this order (Caddy's default order would run forward_auth before request_header).
(gated) {
	request_header -X-Remote-User
	request_header -X-Webauth-User
	forward_auth 127.0.0.1:8100 {
		uri /api/gate
		copy_headers X-Remote-User
		# The address this request came from, and the secret that shows Caddy said so (hub/devices.py): the hub
		# lets the owner's own Tailscale devices through by it. Set here, never taken from the client.
		header_up X-Hub-Peer {remote_host}
		header_up X-Hub-Proxy {$HUB_PROXY_SECRET}
	}
	# The gate's own cookie is for the gate alone: tools behind it see it emptied. (Caddy 2.6 drops an empty
	# replacement, so the name stays with no value.)
	request_header Cookie "hub_gate=[^;]*" "hub_gate="
}

# Each tool once, served on both its home.arpa name and its real name (below).
(site_hub) {
	# Lab uploads are at most 8 MiB; Caddy refuses a bigger body before it reaches the hub.
	handle /api/lab/* {
		request_body {
			max_size 9MB
		}
		reverse_proxy 127.0.0.1:8100 {
			import hub_peer
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8100 {
			import hub_peer
		}
	}
}

# {args[0]}: the address this copy answers on, for the Origin rewrite.
(site_assistant) {
	route {
		import gated
		# Local AI's own Caddy answers only its own names, so ask it as 10.0.0.21. Its same-origin check compares
		# Origin with Host, so a request from this page carries 10.0.0.21 as its Origin too; any other Origin passes
		# unchanged and is refused there as before.
		@own header Origin {args[0]}
		request_header @own Origin https://10.0.0.21
		reverse_proxy https://10.0.0.21 {
			header_up Host 10.0.0.21
			transport http {
				tls_insecure_skip_verify
			}
		}
	}
}

(site_network) {
	route {
		import gated
		# Grafana trusts its login header only from 127.0.0.1, and only under a secret name that Caddy and Grafana
		# alone know (GRAFANA_GATE_HEADER in /etc/pi-hub/secrets/grafana_gate.env), so nothing else on the Pi (Uptime
		# Kuma can send any header) can sign in as the owner. Caddy won't start without the file.
		request_header -{$GRAFANA_GATE_HEADER:X-Gate-Unset}
		reverse_proxy 127.0.0.1:3000 {
			header_up {$GRAFANA_GATE_HEADER:X-Gate-Unset} {http.request.header.X-Remote-User}
		}
	}
}

(site_pi) {
	route {
		import gated
		reverse_proxy https://127.0.0.1:9090 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}
}

# The family-room panel (the Skylight; docs/operations.md "Family-room panel"): its pages from /srv/family-room/current,
# published from the Mac by deploy/family-room-release.sh, and the laundry status from the hub. Caddy adds the panel's
# Shortcut key (FAMILY_ROOM_HUB_KEY in /etc/pi-hub/secrets/family_room.env), so the key never reaches the display;
# without the file the hub refuses the call and the panel says Pi Hub isn't answering. Read-only, and only for the
# Skylight on the house network (10.0.0.18, a DHCP reservation) and the owner's Mac, which reaches the Pi over
# Tailscale (100.109.178.34). In `route` so the checks run first, in this order.
(site_family) {
	route {
		@outsider not remote_ip 10.0.0.18/32 100.109.178.34/32
		respond @outsider "Not here." 403
		@write not method GET HEAD
		respond @write 405
		@laundry path /api/laundry
		handle @laundry {
			rewrite * /api/shortcut/laundry
			reverse_proxy 127.0.0.1:8100 {
				header_up Authorization "Bearer {$FAMILY_ROOM_HUB_KEY}"
				header_up -Cookie
				# No hub_peer: the panel is never the owner, even from the owner's Mac; its key is all it carries.
				header_up -X-Hub-Peer
				header_up -X-Hub-Proxy
			}
		}
		handle {
			root * /srv/family-room/current
			header Cache-Control "no-cache"
			file_server
		}
	}
}

# A gated tool on a plain upstream: {args[0]}.
(site_tool) {
	route {
		import gated
		reverse_proxy {args[0]}
	}
}

# The old hub name, for the machines that still pin it: the Workshop display (its feed, /api/display/*, checked against
# this CA) and the Mac's Print lab sync (/api/lab/*), plus the CA root. A browser goes to the same page on the hub.
home.home.arpa {
	handle /home-ca.crt {
		root * /var/lib/caddy/.local/share/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	# Lab uploads are at most 8 MiB; Caddy refuses a bigger body before it reaches the hub.
	handle /api/lab/* {
		request_body {
			max_size 9MB
		}
		reverse_proxy 127.0.0.1:8100 {
			import hub_peer
		}
	}
	handle /api/display/* {
		reverse_proxy 127.0.0.1:8100 {
			import hub_peer
		}
	}
	handle {
		redir https://hub.rahe-home.duckdns.org{uri} 308
	}
}

# Every other old name (retired 1 Nov 2026) goes to the same page on its real name.
*.home.arpa {
	redir https://{labels.2}.rahe-home.duckdns.org{uri} 308
}

# The real names (docs/superpowers/specs/2026-11-01-real-names-design.md): every tool at <tool>.rahe-home.duckdns.org
# under one Let's Encrypt wildcard certificate, which Caddy gets and renews through DuckDNS (the token is in
# /etc/pi-hub/secrets/duckdns.env). Public DNS points the name at the Pi's Tailscale address, so only the tailnet (and,
# through AdGuard, the house) reaches it. The hub here is hub.; the bare name has no site.
*.rahe-home.duckdns.org {
	tls {
		issuer acme {
			dns duckdns {env.DUCKDNS_TOKEN}
		}
	}
	@hub host hub.rahe-home.duckdns.org
	handle @hub {
		import site_hub
	}
	@assistant host assistant.rahe-home.duckdns.org
	handle @assistant {
		import site_assistant https://assistant.rahe-home.duckdns.org
	}
	@bambuddy host bambuddy.rahe-home.duckdns.org
	handle @bambuddy {
		import site_tool 127.0.0.1:8000
	}
	@paperless host paperless.rahe-home.duckdns.org
	handle @paperless {
		import site_tool 10.0.0.21:8010
	}
	@homebox host homebox.rahe-home.duckdns.org
	handle @homebox {
		import site_tool 127.0.0.1:7745
	}
	@backups host backups.rahe-home.duckdns.org
	handle @backups {
		import site_tool 127.0.0.1:9898
	}
	@network host network.rahe-home.duckdns.org
	handle @network {
		import site_network
	}
	@status host status.rahe-home.duckdns.org
	handle @status {
		import site_tool 127.0.0.1:3001
	}
	@adguard host adguard.rahe-home.duckdns.org
	handle @adguard {
		import site_tool 127.0.0.1:3002
	}
	@devices host devices.rahe-home.duckdns.org
	handle @devices {
		import site_tool 127.0.0.1:8581
	}
	@pi host pi.rahe-home.duckdns.org
	handle @pi {
		import site_pi
	}
	@scan host scan.rahe-home.duckdns.org
	handle @scan {
		import site_tool 127.0.0.1:8095
	}
	@family host family.rahe-home.duckdns.org
	handle @family {
		import site_family
	}
	# Any other name under it: nothing here.
	handle {
		abort
	}
}

# Workshop OS update files for the WS350 display: a static, read-only copy of releases/ and firmware/*.bin that the
# post-receive hook in /srv/bambuhelper-smart-display.git publishes from main. Not gated: the display has no hub
# session, and every file it installs is checked against the manifest's size and SHA-256. The display pins this name
# to the Pi and trusts only this CA, so it needs no DNS.
updates.home.arpa {
	root * /srv/bambuhelper-updates/current
	file_server
	header /releases/device-update.json Cache-Control no-store
}

# The old addresses (http://10.0.0.30, http://pi, http://pi.local, the Tailscale name) are retired (one home, step 6):
# a browser goes to the same page on the hub. Only the machine callers' paths still reach the hub over plain http, on
# any host name: Local AI's /api/now (and its poster images), /api/needs and /api/records (its printer reading), Bambuddy's webhook, Siri Shortcuts (each with its own key or token), the
# health check, and the CA root. The PC's backup pull is ssh and never came through here.
http:// {
	# A house name over plain http goes to the hub over https, so the owner password never crosses the network in the
	# clear.
	@named host home.arpa *.home.arpa rahe-home.duckdns.org *.rahe-home.duckdns.org
	redir @named https://hub.rahe-home.duckdns.org{uri}
	# The CA root, so a new device can trust it before the names resolve (http://10.0.0.30/home-ca.crt).
	handle /home-ca.crt {
		root * /var/lib/caddy/.local/share/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	@machine path /api/now /api/now/* /api/needs /api/records /api/webhook/bambuddy /api/shortcut/* /healthz
	handle @machine {
		reverse_proxy 127.0.0.1:8100
	}
	handle {
		redir https://hub.rahe-home.duckdns.org{uri} 308
	}
}
