[Unit]
Description=Pi Hub, the home hub web app
After=network-online.target pi-status.service
Wants=network-online.target

[Service]
User=pi-hub
Group=pi-hub
WorkingDirectory=/opt/pi-hub/current
ExecStart=/usr/bin/python3 -m uvicorn hub.app:app --host 127.0.0.1 --port 8100 --no-access-log --proxy-headers --timeout-graceful-shutdown 5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/pi-hub
# Media › Add a movie writes into the PC's Movies share (hub/uploads.py); the share is mounted gid=pi-hub, group-writable
# (deploy/movies-share-writable.sh).
ReadWritePaths=-/mnt/windows-movies
StateDirectory=pi-hub
Restart=on-failure
TimeoutStopSec=15
Nice=5
MemoryMax=200M

[Install]
WantedBy=multi-user.target
