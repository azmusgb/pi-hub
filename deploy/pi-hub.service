[Unit]
Description=Pi Hub, the home hub web app
After=network-online.target pi-status.service
Wants=network-online.target

[Service]
User=pi-hub
Group=pi-hub
WorkingDirectory=/opt/pi-hub/current
ExecStart=/usr/bin/python3 -m uvicorn hub.app:app --host 0.0.0.0 --port 80 --no-access-log --proxy-headers
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/pi-hub
StateDirectory=pi-hub
Restart=on-failure
Nice=5
MemoryMax=200M

[Install]
WantedBy=multi-user.target
