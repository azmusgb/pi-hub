#!/bin/bash
# net-health: Fast layered network diagnostics
set -euo pipefail

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

echo -e "${BOLD}${CYAN}=== NETMON Network Diagnostics ===${NC}"
echo -e "Time: $(date)\n"

probe_icmp() {
    local target="$1"
    local desc="$2"
    printf "%-38s " "$desc ($target):"
    if out=$(ping -c 2 -W 2 "$target" 2>&1); then
        avg=$(echo "$out" | tail -1 | awk -F '/' '{print $5}')
        loss=$(echo "$out" | grep -oE '[0-9]+% packet loss')
        echo -e "${GREEN}[OK]${NC} avg=${avg}ms (${loss})"
    else
        echo -e "${RED}[FAIL]${NC} unreachable"
    fi
}

probe_dns() {
    local server="$1"
    local desc="$2"
    printf "%-38s " "$desc ($server):"
    if out=$(dig @"$server" google.com +time=2 +tries=1 +stats 2>&1); then
        if echo "$out" | grep -q "status: NOERROR"; then
            time_ms=$(echo "$out" | grep "Query time:" | awk '{print $4}')
            echo -e "${GREEN}[OK]${NC} ${time_ms} ms"
        else
            echo -e "${RED}[FAIL]${NC} resolution error"
        fi
    else
        echo -e "${RED}[FAIL]${NC} timeout"
    fi
}

probe_http() {
    local url="$1"
    local desc="$2"
    printf "%-38s " "$desc:"
    if out=$(curl -o /dev/null -s -w "%{http_code} in %{time_total}s" --max-time 3 "$url" 2>&1); then
        echo -e "${GREEN}[OK]${NC} HTTP $out"
    else
        echo -e "${RED}[FAIL]${NC} connection failed"
    fi
}

probe_tcp() {
    local host="$1"
    local port="$2"
    local desc="$3"
    printf "%-38s " "$desc ($host:$port):"
    if nc -z -w 2 "$host" "$port" 2>/dev/null; then
        echo -e "${GREEN}[OK]${NC} connected"
    else
        echo -e "${RED}[FAIL]${NC} closed/timeout"
    fi
}

echo -e "${BOLD}--- Layered WAN & Gateway Probes ---${NC}"
probe_icmp "10.0.0.1" "Layer A1 (Orbi Router)"
probe_icmp "192.168.1.254" "Layer A2 (AT&T Gateway)"
probe_icmp "1.1.1.1" "Layer B (Cloudflare IP)"
probe_icmp "8.8.8.8" "Layer B (Google IP)"
probe_dns "10.0.0.1" "Layer C (Router DNS)"
probe_dns "1.1.1.1" "Layer C (Cloudflare DNS)"
probe_http "https://www.google.com" "Layer D (Google HTTPS)"
probe_http "https://1.1.1.1" "Layer D (Cloudflare HTTPS)"

echo -e "\n${BOLD}--- LAN Devices & Services ---${NC}"
probe_icmp "10.0.0.81" "Windows 11 Workstation"
probe_icmp "10.0.0.136" "Bambu P1S Printer"
probe_icmp "10.0.0.124" "Workshop Smart Display"
probe_tcp "10.0.0.81" "22" "Windows SSH"
probe_tcp "10.0.0.81" "445" "Windows SMB Movie Share"
probe_tcp "10.0.0.81" "80" "Windows Web / Local AI"

echo -e "\n${BOLD}--- Appliance Health ---${NC}"
echo "Pi IP: $(hostname -I | awk '{print $1}') | Hostname: $(hostname)"
echo "Memory: $(free -h | awk '/Mem:/ {print $3 "/" $2 " used"}') | Storage (/mnt/usb1): $(df -h /mnt/usb1 | awk 'NR==2 {print $4 " free"}')"
if [ -f /sys/class/thermal/thermal_zone0/temp ]; then
    temp_c=$(awk '{printf "%.1f", $1/1000}' /sys/class/thermal/thermal_zone0/temp)
    echo "SoC Temp: ${temp_c}°C"
fi
echo -e "${CYAN}===================================${NC}"
