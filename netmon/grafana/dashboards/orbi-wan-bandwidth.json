  "timezone": "browser",
  "title": "Orbi WAN Bandwidth & Household Traffic Accounting",
  "uid": "netmon-orbi-wan",
  "version": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 200,
      "title": "Live Internet Demarcation & Gateway Telemetry",
      "type": "row"
    },
    {
      "id": 201,
      "title": "Instant Download Rate",
      "type": "gauge",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "rate(orbi_wan_bytes_received_total[1m]) * 8",
          "legendFormat": "Download Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "max": 1000000000,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500000000
              },
              {
                "color": "red",
                "value": 850000000
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 202,
      "title": "Instant Upload Rate",
      "type": "gauge",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "rate(orbi_wan_bytes_sent_total[1m]) * 8",
          "legendFormat": "Upload Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "max": 1000000000,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500000000
              },
              {
                "color": "red",
                "value": 850000000
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 203,
      "title": "Router Uptime",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "orbi_uptime_seconds",
          "legendFormat": "Uptime"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#10b981"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "value"
      }
    },
    {
      "id": 204,
      "title": "Physical Link Status",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "orbi_wan_link_status",
          "legendFormat": "Link"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Up (1 Gbps)",
                  "color": "green"
                },
                "0": {
                  "text": "Down",
                  "color": "red"
                }
              }
            }
          ]
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "background"
      }
    },
    {
      "id": 205,
      "title": "Active UPnP Port Forwards",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "orbi_port_mappings_count",
          "legendFormat": "Ports"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#a855f7"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "value"
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 210,
      "title": "Household Real-Time Internet Bandwidth Flow",
      "type": "row"
    },
    {
      "id": 211,
      "title": "Internet WAN Download & Upload Traffic (Entire Home)",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "rate(orbi_wan_bytes_received_total[1m])",
          "legendFormat": "Internet Download (Rx)"
        },
        {
          "expr": "rate(orbi_wan_bytes_sent_total[1m])",
          "legendFormat": "Internet Upload (Tx)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "binBps",
          "custom": {
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 25,
            "gradientMode": "opacity"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Internet Download (Rx)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#00d1b2",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Internet Upload (Tx)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#209cee",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "id": 220,
      "title": "Data Accounting & Packet Dynamics",
      "type": "row"
    },
    {
      "id": 221,
      "title": "Total Data Transferred (Selected Time Range)",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "increase(orbi_wan_bytes_received_total[$__range])",
          "legendFormat": "Total Downloaded"
        },
        {
          "expr": "increase(orbi_wan_bytes_sent_total[$__range])",
          "legendFormat": "Total Uploaded"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Total Downloaded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#00d1b2",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Total Uploaded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#209cee",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "value",
        "orientation": "vertical"
      }
    },
    {
      "id": 222,
      "title": "WAN Packet Transfer Rate (Packets / Second)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "rate(orbi_wan_packets_received_total[1m])",
          "legendFormat": "Packets Inbound (Rx/s)"
        },
        {
          "expr": "rate(orbi_wan_packets_sent_total[1m])",
          "legendFormat": "Packets Outbound (Tx/s)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "lineInterpolation": "smooth",
            "lineWidth": 1.5,
            "fillOpacity": 15,
            "gradientMode": "opacity"
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "id": 230,
      "title": "Hop-by-Hop Demarcation Latency",
      "type": "row"
    },
    {
      "id": 231,
      "title": "Hop Latency: Orbi Router vs AT&T Fiber vs Public WAN (ms)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "probe_duration_seconds{instance=\"10.0.0.1\"} * 1000",
          "legendFormat": "Hop 1: Orbi Router (10.0.0.1)"
        },
        {
          "expr": "probe_duration_seconds{instance=\"192.168.1.254\"} * 1000",
          "legendFormat": "Hop 2: AT&T Gateway (192.168.1.254)"
        },
        {
          "expr": "probe_duration_seconds{instance=\"1.1.1.1\"} * 1000",
          "legendFormat": "Hop 3: Cloudflare WAN (1.1.1.1)"
        },
        {
          "expr": "probe_duration_seconds{instance=\"8.8.8.8\"} * 1000",
          "legendFormat": "Hop 3: Google WAN (8.8.8.8)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Hop 1: Orbi Router (10.0.0.1)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#00d1b2",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Hop 2: AT&T Gateway (192.168.1.254)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#209cee",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Hop 3: Cloudflare WAN (1.1.1.1)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#f59e0b",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Hop 3: Google WAN (8.8.8.8)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#a855f7",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}