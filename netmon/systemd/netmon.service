[Unit]
Description=NETMON Diagnostic Appliance Stack
After=docker.service mnt-usb1.mount
Requires=docker.service mnt-usb1.mount

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/netmon
ExecStart=/usr/bin/docker-compose up -d --remove-orphans
ExecStop=/usr/bin/docker-compose down

[Install]
WantedBy=multi-user.target
